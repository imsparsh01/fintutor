{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--port",
        "8000",
        "--app-dir",
        "backend"
      ],
      "port": 8000
    },
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app", "run", "web", "--", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "app-dev-user",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "EXPO_PUBLIC_DEV_USER_ID=00000000-0000-0000-0000-000000000001 npm --prefix app run web -- --port 8082"
      ],
      "port": 8082
    }
  ]
}

# Backend (FastAPI) secrets. Copy this file to `.env` in the repo root and fill in real values.
# The repo-root `.env` is gitignored (see .gitignore) — never commit real values.
# Read by backend/app/core/config.py. Supabase URL/anon-key configuration remains in
# app/.env because both Expo and the backend token verifier use the same public values.

# Supabase Postgres connection string (Project Settings -> Database -> Connection string -> URI,
# for project fintutor-dev). Includes the DB password — keep it secret. Needed for ALL screens
# except Chat. Example shape (do not use literally):
#   postgresql://postgres:<PASSWORD>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=

# Anthropic API key (the `fintutor-dev` key). ONLY needed for the /chat teaching flow — every
# other screen (Home, Sections, Budget, Consolidated) works without it. Leave blank to bring the
# app up now and add later when you want to test Chat.
ANTHROPIC_API_KEY=

# Backend-only Supabase secret/legacy service-role key, required solely for permanent Auth-user deletion.
# Never place this value in app/.env or any EXPO_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=
